# Previous site's backup — contains DB dumps, plaintext credentials (config.php),
# and PII (form submission logs/uploads). NEVER commit anything under archive/.
archive/

# Database dumps anywhere in the tree
*.sql
*.sql.gz

# Dependencies & local environment
node_modules/
.env
local.settings.json

# OS noise
Thumbs.db
.DS_Store

# One-off migration script output (regenerable, not source of truth)
scripts/out/

# Local blog-content backups (scripts/backup-blog.mjs). These are a copy of live
# production data — keep them out of git and store them somewhere off this machine.
backups/

# Python bytecode from scripts/
__pycache__/
*.pyc
