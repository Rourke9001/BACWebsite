# Mirrored site content must stay byte-exact — no EOL conversion
site/** -text

# The chrome expander (scripts/build-chrome.mjs) writes generated bytes into these
# and a CI check compares them byte-for-byte. core.autocrlf=true would otherwise
# hand a Windows checkout CRLF working copies of LF blobs, so every generated file
# would read as fully changed. Pin them for the same reason site/** is pinned.
api/src/blog-templates/** -text
partials/** -text
data/** -text
